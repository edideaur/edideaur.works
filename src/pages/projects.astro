---

<Base title="PROJECTS" active="/projects" description="stuff i've built: monochrome, unreleased music trackers, web tools, and apis.">
    <section class="post">
        <div class="title">PROJECTS</div>
        <div class="entry">
            {projects.map((p) => (
                <div class="project-card">
                    <div class="card-header">
                        {p.url ? (
                            <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                        ) : (
                            <a>{p.name}</a>
                        )}
                        {p.source && (
                            <a href={p.source} target="_blank" rel="noopener noreferrer" class="project-status">[SOURCE]</a>
                        )}
                    </div>
                    <div class="card-body">
                        <p class="project-desc">{p.desc}</p>
                        <div style="margin-top: 0.75rem;">
                            {p.tags.map((t) => (
                                <span class="blog-tag">{t}</span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <div class="title" style="margin-top: 2rem;">CONTRIBUTED TO</div>
        <div class="entry">
            {contributions.map((c) => (
                <div class="project-card">
                    <div class="card-header">
                        <a href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
                        {c.source ? (
                            <a href={c.source} target="_blank" rel="noopener noreferrer" class="project-status">{c.statusText}</a>
                        ) : (
                            <span class="project-status">{c.statusText}</span>
                        )}
                    </div>
                    <div class="card-body">
                        <p class="project-desc">{c.desc}</p>
                        <div style="margin-top: 0.75rem;">
                            {c.tags.map((t) => (
                                <span class="blog-tag">{t}</span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Base>

<style>
    .card-header a,
    .card-header a:hover {
        text-decoration: none !important;
        border-bottom: none !important;
    }
</style>
