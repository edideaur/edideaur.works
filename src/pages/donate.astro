    { name: 'Bitcoin - Active', label: 'Bitcoin (Active)', address: 'bc1qzl0kznz3xxdpmz2m77qe3mx8ds06tcvm7pk2t4' },
    { name: 'Bitcoin - P2WPKH', label: 'Bitcoin (P2WPKH)', address: 'bc1qf7elcxp394a7ly5pgqg0wsetzkkqn2xrlzpeh2' },
    { name: 'Bitcoin - P2PKH', label: 'Bitcoin (P2PKH)', address: '1NnLbNBH8RcTfbfEpZyf1iW1ezXv3XBAQR' },
