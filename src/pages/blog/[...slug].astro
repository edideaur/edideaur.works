---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const dateObj = d instanceof Date ? d : new Date(d + 'T00:00:00');
const formatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const isoDate = dateObj.toISOString();
const SITE = 'https://edideaur.works';
const postUrl = `${SITE}/blog/${post.slug}/`;

function extractSnippet(body?: string): string {
    if (!body) return 'i do cool shit';
    const clean = body
        .replace(/^---[\s\S]*?---/, '')
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/[`#*_~>]/g, '')
        .trim();
    const firstPara = clean.split(/\n\s*\n/)[0] || '';
    return firstPara.length > 200 ? `${firstPara.slice(0, 197)}...` : firstPara;
}

const description = post.data.excerpt || post.data.description || extractSnippet(post.body);
const ogImage = post.data.image ? (post.data.image.startsWith('http') ? post.data.image : `${SITE}${post.data.image}`) : `${SITE}/avatar.jpg`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: description,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: 'en',
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  image: ogImage,
  author: { '@type': 'Person', name: 'edideaur', url: SITE },
  publisher: { '@type': 'Person', name: 'edideaur', url: SITE },
  keywords: post.data.tags?.join(', ') || '',
};
---

<Base title={post.data.title} description={description} ogImage={ogImage} active="/blog/" type="article">
    <link rel="author" href={SITE}>
    <meta property="article:published_time" content={isoDate}>
    <meta property="article:modified_time" content={isoDate}>
    {post.data.tags?.map((t: string) => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)}></script>
    <section class="post h-entry">
        <div class="entry blog-back-container">
            <a href="/blog/" class="blog-back" aria-label="Back to blog">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
            </a>
        </div>
        <div class="title p-name">{post.data.title}</div>
        <a class="u-url" href={postUrl} hidden>{post.data.title}</a>
        <div class="entry">
            <time class="blog-post-meta dt-published" datetime={isoDate} style="margin-bottom: 1rem; display: block;">{formatted}</time>
            {post.data.image && <img class="u-photo" src={post.data.image} alt={post.data.title} style="width:100%;height:auto;border:1px solid var(--border);margin-bottom:1rem;">}
            <div class="prose e-content"><Content /></div>
            <a class="p-author h-card" href="https://edideaur.works" hidden>edideaur</a>
        </div>
    </section>
</Base>

<style>
    .blog-back-container {
        padding-top: 12px;
        padding-bottom: 0;
    }
    .blog-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none !important;
        border-bottom: none !important;
        color: var(--fg-dim);
        transition: color 0.15s, transform 0.15s;
    }
    .blog-back:hover {
        color: var(--accent);
        text-decoration: none;
        border: none !important;
        border-bottom: none !important;
        transform: translateX(-2px);
    }
</style>
