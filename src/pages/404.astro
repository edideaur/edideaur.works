---
import Base from '../layouts/Base.astro';
---

<Base title="404" active="" description="page not found.">
    <div class="error-page">
        <div class="error-code">404</div>
        <div class="error-text">you got lost.</div>
        <div class="error-sub">this page wandered off and never came back.</div>
        <a href="/" class="error-link">take me home</a>
    </div>
</Base>

<style>
    .error-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        text-align: center;
        padding: 2rem;
    }
    .error-code {
        font-family: var(--font-sans);
        font-size: clamp(6rem, 20vw, 12rem);
        line-height: 1;
        color: var(--accent);
        opacity: 0.3;
        margin-bottom: 1rem;
    }
    .error-text {
        font-size: 12px;
        color: var(--fg-dim);
        margin-bottom: 0.25rem;
    }
    .error-sub {
        font-size: 11px;
        color: var(--fg-muted);
        margin-bottom: 2rem;
    }
    .error-link {
        color: var(--accent);
        border-bottom: 1px solid var(--accent);
        transition: color 0.2s, border-color 0.2s;
    }
    .error-link:hover {
        color: var(--fg-bright);
        border-color: var(--fg-bright);
    }
</style>
