    <section class="post">
        <div class="title">LINKS</div>
        <div class="entry prose">
            <h2>Privacy & Security</h2>
            <ul>
                <li><a href="https://protonvpn.com/">Proton VPN</a> - Free VPN with strong privacy</li>
                <li><a href="https://mullvad.net/">Mullvad</a> - Privacy-focused VPN, no email needed</li>
                <li><a href="https://fmhy.net/privacy">FMHY Privacy</a> - Privacy tools and guides</li>
