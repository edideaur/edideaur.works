    <script is:inline>
        (function() {
            var guides = {
                android: '<p>Go to <strong>Settings</strong> &rarr; <strong>Network &amp; internet</strong> &rarr; <strong>Advanced</strong> &rarr; <strong>Private DNS</strong>.<br>Select <strong>Private DNS provider hostname</strong> and enter: <code class="highlightable" data-copy="7af1b9.dns.nextdns.io">7af1b9.dns.nextdns.io<span class="copy-feedback">COPIED</span></code></p>',
                ios: '<p>Install the <a href="https://apple.nextdns.io" target="_blank" rel="noopener noreferrer">NextDNS Configuration Profile</a> or download NextDNS from the App Store and enter ID <code class="highlightable" data-copy="7af1b9">7af1b9<span class="copy-feedback">COPIED</span></code>.</p>',
                windows: '<p>Download the <a href="https://nextdns.io/download/windows" target="_blank" rel="noopener noreferrer">NextDNS app for Windows</a> and enter ID <code class="highlightable" data-copy="7af1b9">7af1b9<span class="copy-feedback">COPIED</span></code>, or configure YogaDNS with DoH URL: <code class="highlightable" data-copy="https://dns.nextdns.io/7af1b9">https://dns.nextdns.io/7af1b9<span class="copy-feedback">COPIED</span></code>.</p>',
                macos: '<p>Download the <a href="https://nextdns.io/download/macos" target="_blank" rel="noopener noreferrer">NextDNS app for macOS</a> or install the profile from <a href="https://apple.nextdns.io" target="_blank" rel="noopener noreferrer">apple.nextdns.io</a> with ID <code class="highlightable" data-copy="7af1b9">7af1b9<span class="copy-feedback">COPIED</span></code>.</p>',
                linux: '<p>Run the installation script in terminal:<br><code class="highlightable" data-copy="sh -c &quot;$(curl -sL https://nextdns.io/install)&quot;">sh -c "$(curl -sL https://nextdns.io/install)"<span class="copy-feedback">COPIED</span></code><br>And enter your NextDNS ID: <code class="highlightable" data-copy="7af1b9">7af1b9<span class="copy-feedback">COPIED</span></code>.</p>',
                chromeos: '<p>Go to <strong>Settings</strong> &rarr; <strong>Security and Privacy</strong> &rarr; <strong>Use secure DNS</strong> &rarr; select <strong>Custom</strong> and enter: <code class="highlightable" data-copy="https://dns.nextdns.io/7af1b9">https://dns.nextdns.io/7af1b9<span class="copy-feedback">COPIED</span></code></p>',
                browsers: '<p>In Firefox, Chrome, or Brave settings, search for <strong>Secure DNS</strong> (or <strong>DNS over HTTPS</strong>), select <strong>Custom</strong> provider and enter: <code class="highlightable" data-copy="https://dns.nextdns.io/7af1b9">https://dns.nextdns.io/7af1b9<span class="copy-feedback">COPIED</span></code></p>',
                routers: '<p>Set DNS servers in your router settings:<br>IPv4: <code class="highlightable" data-copy="45.90.28.0">45.90.28.0<span class="copy-feedback">COPIED</span></code> and <code class="highlightable" data-copy="45.90.30.0">45.90.30.0<span class="copy-feedback">COPIED</span></code><br>Linked to ID: <code class="highlightable" data-copy="7af1b9">7af1b9<span class="copy-feedback">COPIED</span></code></p>',
                pfsense: '<p>Services &rarr; <strong>DNS Resolver</strong> &rarr; Enable <strong>DNS Query Forwarding</strong> and add custom options with DoT forwarding to <code class="highlightable" data-copy="7af1b9.dns.nextdns.io">7af1b9.dns.nextdns.io<span class="copy-feedback">COPIED</span></code>.</p>',
                mikrotik: '<p>Run in terminal:<br><code class="highlightable" data-copy="/ip dns set use-doh-server=&quot;https://dns.nextdns.io/7af1b9&quot; verify-doh-cert=yes">/ip dns set use-doh-server="https://dns.nextdns.io/7af1b9" verify-doh-cert=yes<span class="copy-feedback">COPIED</span></code></p>'
            };

            function setupDeviceSelect() {
                var select = document.getElementById('device-select');
                var container = document.getElementById('instructions');
                if (!select || !container || select.dataset.bound) return;
                select.dataset.bound = '1';

                select.addEventListener('change', function() {
                    var val = select.value;
                    container.innerHTML = guides[val] || '';
                    container.querySelectorAll('.highlightable').forEach(function(codeBlock) {
                        codeBlock.addEventListener('click', function(e) {
                            var el = e.currentTarget;
                            var text = el.dataset.copy || el.innerText.trim();
                            navigator.clipboard.writeText(text).then(function() {
                                el.classList.add('copied');
                                setTimeout(function() { el.classList.remove('copied'); }, 1500);
                            });
                        });
                    });
                });
            }

            document.addEventListener('astro:page-load', setupDeviceSelect);
            setupDeviceSelect();
        })();
    </script>
</Base>
